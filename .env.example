NODE_ENV=development
PORT=3715
TRUST_PROXY=1
BODY_LIMIT=10mb
CORS_ORIGINS=*
CORS_MAX_AGE=86400
MONGODB_URI=mongodb://127.0.0.1:27017/chat
JWT_SECRET=replace-with-a-long-random-secret
JWT_SALT_ROUNDS=10
SHUTDOWN_TIMEOUT_MS=60000
PUBLIC_URL=http://localhost:3715
SWAGGER_SERVER=
LOG_LEVEL=debug

# Firebase project used by the existing React app (no service account in source).
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
# Optional on local hosts using a credential file; omit for managed ADC environments.
GOOGLE_APPLICATION_CREDENTIALS=
# HTTPS origin only. Existing frontend conversation route is /?conversationId=<id>.
PWA_BASE_URL=
PUSH_TIMEOUT_MS=5000
